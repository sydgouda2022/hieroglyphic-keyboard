{
  "name": "@sydgouda/hieroglyphic-keyboard",
  "version": "2.0.0",
  "description": "Headless, offline-capable Egyptian Unicode hieroglyphic keyboard API",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "exports": {
    ".": "./src/keyboard_api.mjs",
    "./core": "./src/keyboard_api.mjs",
    "./search": "./src/keyboard_search.mjs",
    "./installer": "./src/lexicon_install.mjs",
    "./catalog": "./src/keyboard_catalog.js",
    "./data/manifest": "./release/manifest.json",
    "./data/lexicon": "./release/lexicon.json",
    "./data/coverage": "./release/coverage.json"
  },
  "files": [
    "src/keyboard_api.mjs",
    "src/keyboard_search.mjs",
    "src/keyboard_catalog.js",
    "src/lexicon_install.mjs",
    "release/manifest.json",
    "release/lexicon.json",
    "release/coverage.json",
    "README.md",
    "docs/INTEGRATION.md",
    "docs/UPSTREAM_SOURCE.md",
    "docs/THIRD_PARTY_NOTICES.md",
    "sources/README.md",
    "sources/late_egyptian_registry.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
